{
  "name": "wts-data-table-angular-example",
  "version": "1.1.1",
  "description": "Documentation and interactive Angular examples for WTS Data Table.",
  "homepage": "https://wts-data-table.github.io/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wts-data-table/wts-data-table.github.io.git"
  },
  "bugs": {
    "url": "https://github.com/wts-data-table/wts-data-table.github.io/issues"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:pages": "ng build --configuration production",
    "prebuild:pages": "node scripts/verify-card-view-package.mjs && node scripts/configure-demo-license.mjs && node scripts/verify-site-metadata.mjs && npm run test:framework-examples",
    "postbuild:pages": "npm run test:site-checks && node scripts/verify-rendered-seo.mjs && node scripts/verify-site-links.mjs",
    "test:site-checks": "node --test scripts/verify-site-links.test.mjs",
    "test:framework-examples": "node scripts/verify-framework-examples.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/common": "22.1.4",
    "@angular/compiler": "22.1.4",
    "@angular/core": "22.1.4",
    "@angular/forms": "22.1.4",
    "@angular/platform-browser": "22.1.4",
    "@angular/platform-server": "22.1.4",
    "@angular/router": "22.1.4",
    "@angular/ssr": "22.1.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "wts-data-table": "1.1.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.3",
    "@angular/cli": "22.1.3",
    "@angular/compiler-cli": "22.1.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wts-data-table/angular": "1.0.0",
    "@wts-data-table/react": "1.0.0",
    "@wts-data-table/vue": "1.0.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8",
    "vue": "3.5.43",
    "vue-tsc": "3.3.11"
  }
}
